---
import ObservablePlot from './ObservablePlot.astro';
import crossTopic from '../../data/embedding-hubness/figures/cross-topic-by-k.json';

const first = crossTopic.points[0];
const last = crossTopic.points[crossTopic.points.length - 1];
---

<ObservablePlot
  id="fig-cross-topic"
  title="Figure 2 · Cross-topic neighbor edges by k"
  description="The share of nearest-neighbor edges that cross into a different topic, as the neighborhood size k grows."
  srDescription={`Dot and line plot of the cross-topic neighbor rate at four values of k: ${crossTopic.points
    .map((p) => `k=${p.k}, ${Math.round(p.crossTopicRate * 100)} percent`)
    .join('; ')}. The rate rises from ${Math.round(first.crossTopicRate * 100)} percent at k=${first.k} to ${Math.round(
    last.crossTopicRate * 100
  )} percent at k=${last.k}.`}
  caption="Share of k-nearest-neighbor edges whose two documents belong to different topics. k is not evenly spaced (1, 3, 5, 10); positions are ordinal, not linear."
  maxWidth="30rem"
  minHeight="14rem"
>
</ObservablePlot>

<script>
  import * as Plot from '@observablehq/plot';
  import crossTopic from '../../data/embedding-hubness/figures/cross-topic-by-k.json';
  import { COLORS, baseStyle, renderResponsive } from './plot-theme';

  const container = document.getElementById('fig-cross-topic');
  if (container) {
    const { points } = crossTopic;
    const domain = points.map((p) => String(p.k));

    renderResponsive(container, (width) =>
      Plot.plot({
        width,
        height: 220,
        marginLeft: 46,
        marginRight: 20,
        marginTop: 20,
        marginBottom: 34,
        style: baseStyle,
        x: { domain, label: 'k (neighborhood size)', labelAnchor: 'center', labelArrow: false, padding: 0.5 },
        y: {
          domain: [0, Math.max(0.6, points[points.length - 1].crossTopicRate * 1.2)],
          label: 'cross-topic share',
          labelArrow: false,
          tickFormat: (d: number) => `${Math.round(d * 100)}%`,
          grid: true
        },
        marks: [
          Plot.line(points, { x: (d) => String(d.k), y: 'crossTopicRate', stroke: COLORS.accentMuted }),
          Plot.dot(points, { x: (d) => String(d.k), y: 'crossTopicRate', fill: COLORS.accent, r: 4.5 }),
          Plot.text(points, {
            x: (d) => String(d.k),
            y: 'crossTopicRate',
            text: (d) => `${Math.round(d.crossTopicRate * 100)}%`,
            dy: -12,
            fill: COLORS.ink
          }),
          Plot.ruleY([0])
        ]
      })
    );
  }
</script>
